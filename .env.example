# 扑通 · Netlify 环境变量（Site configuration → Environment variables）

# —— 模型网关（必填一个 Key，页面才有话说）——
LLM_API_KEY=sk-xxxxxxxx
# LLM_API_BASE=https://api-model.gpulink.cc/v1
# LLM_MODEL=deepseek-v4.1-flash-1017
# LLM_MODEL_FALLBACK=

# —— 访问码（可选）：设了之后访客要先在敲门层填码，防链接外传被刷 ——
ACCESS_CODE=321321

# —— 每日扑通提醒（可选）：两个 key 都设了才开启 Web Push ——
# 生成方式：npx web-push generate-vapid-keys
# PUSH_CONTACT=mailto:you@example.com
# PUSH_VAPID_PUBLIC=Bxxxxxxxxxxxx
# PUSH_VAPID_PRIVATE=xxxxxxxxxxxx
